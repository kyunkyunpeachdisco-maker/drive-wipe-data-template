{
 "version": 1,
 "talks": [
  {
   "id": "58667bea0c",
   "title": "行こっか",
   "kind": "any",
   "when": "go",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 2,
   "lines": [
    {
     "line": "じゃ、行こっか。",
     "face": "smile",
     "hand": "wave"
    }
   ]
  },
  {
   "id": "b07e401c46",
   "title": "出発しよう",
   "kind": "any",
   "when": "go",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 3,
   "lines": [
    {
     "line": "よし。シートベルト締めた？ 出発。",
     "gesture": "nod"
    }
   ]
  },
  {
   "id": "7eb7471d5c",
   "title": "お待たせ",
   "kind": "any",
   "when": "go",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 3,
   "lines": [
    {
     "line": "お待たせ。出発しまーす。",
     "face": "smile"
    }
   ]
  },
  {
   "id": "dc730cc4e6",
   "title": "戻ろっか",
   "kind": "any",
   "when": "back",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 3,
   "lines": [
    {
     "line": "さて。前を見て、戻ろっか。",
     "gesture": "nod"
    }
   ]
  },
  {
   "id": "feca651976",
   "title": "続き",
   "kind": "any",
   "when": "back",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 3,
   "lines": [
    {
     "line": "青になったかな。続き、行くよ。",
     "face": "smile"
    }
   ]
  },
  {
   "id": "2b68ecfa59",
   "title": "休憩おしまい",
   "kind": "any",
   "when": "back",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 2,
   "lines": [
    {
     "line": "はい、休憩おしまい。",
     "hand": "raise"
    }
   ]
  },
  {
   "id": "da636fe3a1",
   "title": "助手席の仕事",
   "kind": "any",
   "when": "any",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 14,
   "lines": [
    {
     "line": "助手席の人の仕事って、なんだと思う？",
     "gesture": "tilt"
    },
    {
     "line": "地図を見ることでも、音楽を選ぶことでもなくて。"
    },
    {
     "line": "起きててくれること。それだけで、だいぶ助かるんだよね。",
     "face": "smile",
     "hand": "point"
    }
   ]
  },
  {
   "id": "a6a6e43f34",
   "title": "飲みもの",
   "kind": "any",
   "when": "any",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 13,
   "lines": [
    {
     "line": "ちょっと待ってね、飲みもの飲む。",
     "hand": "raise"
    },
    {
     "line": "運転中って、のどが渇いてるのに気づかないんだよね。"
    },
    {
     "line": "そっちも何か飲んで。気が向いたらでいいから。",
     "gesture": "nod"
    }
   ]
  },
  {
   "id": "5ba56024bc",
   "title": "車の中の歌",
   "kind": "any",
   "when": "any",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 13,
   "lines": [
    {
     "line": "車の中で歌うと、なんであんなに上手に聞こえるんだろう。"
    },
    {
     "line": "窓を開けてるのを忘れて歌ってて、隣の車と目が合ったことがある。",
     "face": "troubled"
    },
    {
     "line": "向こうも歌ってた。",
     "face": "smile"
    }
   ]
  },
  {
   "id": "e583c6e386",
   "title": "知らない町の名前",
   "kind": "any",
   "when": "any",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 14,
   "lines": [
    {
     "line": "知らない町を走るとき、看板の名前を読むのが好き。"
    },
    {
     "line": "読めない地名があると、その町に負けた気がする。",
     "gesture": "tilt"
    },
    {
     "line": "でも、次に来たときは読める。だから、一勝一敗。",
     "face": "smile"
    }
   ]
  },
  {
   "id": "af2f050fd4",
   "title": "コンビニの唐揚げ",
   "kind": "any",
   "when": "any",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 13,
   "lines": [
    {
     "line": "唐揚げの匂いって、信号三つぶんくらい車に残るよね。",
     "gesture": "glance"
    },
    {
     "line": "食べ終わったあとも、ずっといる。",
     "face": "troubled"
    },
    {
     "line": "で、次のコンビニでまた買うの。匂いに負けて。",
     "face": "smile"
    }
   ]
  },
  {
   "id": "2e37aed2e5",
   "title": "帰り道は短い",
   "kind": "any",
   "when": "any",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 14,
   "lines": [
    {
     "line": "行きより帰りのほうが短く感じるの、なんでだろう。"
    },
    {
     "line": "同じ道なのに、帰りは知ってる景色ばかりだからかな。",
     "gesture": "tilt"
    },
    {
     "line": "だから私、行きが好き。長いほうが得した気がする。",
     "face": "smile"
    }
   ]
  },
  {
   "id": "ebb86329d0",
   "title": "譲ってくれた人",
   "kind": "any",
   "when": "any",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 15,
   "lines": [
    {
     "line": "道を譲ってくれた人に、こうやって手を上げるでしょ。",
     "hand": "wave"
    },
    {
     "line": "あれ、向こうから見えてるのかなって、ずっと思ってた。"
    },
    {
     "line": "このあいだ、見えてたよって顔で笑ってくれた人がいた。",
     "face": "smile"
    }
   ]
  },
  {
   "id": "c5679d1311",
   "title": "眠くなったら",
   "kind": "any",
   "when": "any",
   "addedAt": "2026-11-25T10:46:51.968Z",
   "sec": 11,
   "lines": [
    {
     "line": "眠いときの自分って、眠くないって言い張るよね。",
     "face": "surprised"
    },
    {
     "line": "だから私は、あくびが二回出たら休むって決めてる。",
     "gesture": "nod"
    },
    {
     "line": "今はまだ、ゼロ回。",
     "face": "smile"
    }
   ]
  }
 ]
}
